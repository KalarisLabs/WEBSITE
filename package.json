{
  "name": "kalaris-labs-landing-page",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:ssr": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 8787",
    "start": "astro dev",
    "build": "astro check && astro build",
    "deploy": "astro check && astro build && wrangler deploy --config dist/server/wrangler.json --route \"kalarislabs.com/*\" --route \"www.kalarislabs.com/*\"",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.10",
    "gsap": "^3.12.7",
    "lucide-react": "^1.16.0",
    "posthog-js": "^1.223.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "impeccable": "^4.0.2",
    "wrangler": "^4.129.0"
  }
}
