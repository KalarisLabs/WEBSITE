{
  "name": "kalaris-labs-website",
  "version": "1.0.0",
  "description": "Official website for Kalaris Labs",
  "type": "module",
  "scripts": {
    "dev": "astro dev --config astro.config.dev.mjs",
    "dev:worker": "astro build && wrangler dev",
    "build": "astro build",
    "check": "astro build && astro check && tsc --noEmit && eslint . && prettier --check . && npm run verify:dev-assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "astro build && wrangler dev",
    "deploy": "cross-env CLOUDFLARE_ENV=production astro build && wrangler deploy --env production",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging astro build && wrangler deploy --env staging",
    "deploy:dry-run": "cross-env CLOUDFLARE_ENV=production astro build && wrangler deploy --dry-run --env production",
    "indexnow": "node scripts/indexnow.mjs",
    "cf-types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "cf-types:check": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --check",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify:dev-assets": "node scripts/verify-dev-assets.mjs astro.config.dev.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@rive-app/canvas": "^2.43.1",
    "@sentry/astro": "^11.0.0",
    "@sentry/cloudflare": "^11.0.0",
    "@sentry/replay": "11.0.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.58",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "meshline": "^3.3.1",
    "motion": "^13.4.4",
    "ogl": "^1.0.11",
    "posthog-js": "^1.434.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "simple-icons": "^16.33.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.3.0",
    "gpt-tokenizer": "^4.0.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "optionalDependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "^0.5.1"
  }
}
