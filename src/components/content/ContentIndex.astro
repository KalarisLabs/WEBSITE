---
import type { PublishingCollection, PublishingEntry } from '../../lib/content';
import { entryPath } from '../../lib/content';

interface Props {
  title: string;
  description: string;
  collection: PublishingCollection;
  entries: PublishingEntry[];
}

const { title, description, collection, entries } = Astro.props;
---

<section class="container mx-auto min-h-[70vh] px-4 pt-32 pb-20">
  <p class="text-primary text-sm font-semibold tracking-widest uppercase">
    Kalaris Labs
  </p>
  <h1 class="mt-3 text-4xl font-bold md:text-6xl">{title}</h1>
  <p class="text-muted-foreground mt-5 max-w-2xl text-lg">{description}</p>

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      entries.map((entry) => (
        <article class="border-border bg-card rounded-xl border p-6">
          <p class="text-muted-foreground text-sm">
            <time datetime={entry.data.publishDate.toISOString()}>
              {entry.data.publishDate.toLocaleDateString('en', {
                dateStyle: 'long',
              })}
            </time>
          </p>
          <h2 class="mt-2 text-2xl font-semibold">
            <a class="hover:text-primary" href={entryPath(collection, entry)}>
              {entry.data.title}
            </a>
          </h2>
          <p class="text-muted-foreground mt-3">{entry.data.description}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
            {entry.data.tags.map((tag) => (
              <li class="bg-muted rounded-full px-3 py-1 text-xs">{tag}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
