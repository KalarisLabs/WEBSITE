---
import type { PublishingCollection, PublishingEntry } from '../../lib/content';
import { entryPath } from '../../lib/content';

interface Props {
  title: string;
  description: string;
  collection: PublishingCollection;
  entries: PublishingEntry[];
}

const { title, description, collection, entries } = Astro.props;
---

<header class="page-hero">
  <div class="site-container page-hero-grid">
    <p class="eyebrow">Kalaris Labs / {collection}</p>
    <div><h1>{title}</h1><p class="page-lede">{description}</p></div>
  </div>
</header>

<section class="editorial-section section-rule">
  <div class="site-container">
    <p class="eyebrow">Published / {String(entries.length).padStart(2, '0')}</p>
    <div class="content-list">
      {
        entries.map((entry, index) => (
          <article class="content-row">
            <p class="mono-number">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <p class="content-meta">
                <time datetime={entry.data.publishDate.toISOString()}>
                  {entry.data.publishDate.toLocaleDateString('en', {
                    dateStyle: 'long',
                  })}
                </time>{' '}
                / {entry.data.tags.join(' · ')}
              </p>
              <h2>
                <a href={entryPath(collection, entry)}>{entry.data.title}</a>
              </h2>
              <p>{entry.data.description}</p>
            </div>
            <a
              class="content-arrow"
              href={entryPath(collection, entry)}
              aria-label={`Read ${entry.data.title}`}
            >
              →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
