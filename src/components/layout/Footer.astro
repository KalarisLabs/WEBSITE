---
const docsUrl =
  import.meta.env.PUBLIC_DOCS_URL ?? 'https://docs.kalarislabs.com';
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="content-column footer-content">
    <div class="footer-primary">
      <div class="footer-identity">
        <a href="/" class="brand" aria-label="Kalaris Labs home">
          <img
            src="/kalaris-wordmark.png"
            alt="Kalaris Labs"
            width="150"
            height="46"
          />
        </a>
        <p class="footer-tagline">
          Recursive, self-improving infrastructure for scientific discovery.
        </p>
      </div>

      <nav class="footer-links-grid" aria-label="Footer navigation">
        <div class="footer-nav-group">
          <span class="footer-col-title">Publications</span>
          <a href="/research">Research</a>
          <a href="/blog">Blog</a>
          <a href="/manifesto">Manifesto</a>
          <a href={docsUrl}>Documentation ↗</a>
        </div>
        <div class="footer-nav-group">
          <span class="footer-col-title">Company</span>
          <a href="/company">About</a>
          <a href="/team">Our team</a>
          <a href="/company/careers">Careers</a>
          <a href="mailto:contact@kalarislabs.com">Contact ↗</a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom-bar">
      <p>© {year} Kalaris Labs. All rights reserved.</p>
      <div class="footer-utility-links">
        <a href="/manifesto">Manifesto</a>
        <a href="/rss.xml">RSS</a>
        <a
          href="https://www.linkedin.com/company/kalarislabs"
          target="_blank"
          rel="noopener noreferrer">LinkedIn ↗</a
        >
        <button type="button" data-analytics-preferences>
          Analytics preferences
        </button>
      </div>
    </div>
  </div>
</footer>
