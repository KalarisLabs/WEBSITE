---
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main-grid">
      {/* Brand & Systems Anchor */}
      <div class="footer-brand-col">
        <a href="/" class="footer-brand-link" aria-label="Kalaris Labs home">
          <img
            src="/kalaris-wordmark.png"
            alt="Kalaris Labs"
            width="132"
            height="40"
            class="footer-brand-img"
          />
        </a>
        <p class="footer-tagline">
          Deterministic, self-improving infrastructure for autonomous scientific
          discovery.
        </p>
        <div class="footer-status-pill">
          <span class="status-pulse-dot" aria-hidden="true"></span>
          <span class="status-text">All systems operational</span>
        </div>
      </div>

      {/* Navigation Columns */}
      <div class="footer-nav-grid">
        <div class="footer-nav-col">
          <span class="footer-nav-heading">Infrastructure</span>
          <ul class="footer-nav-list" role="list">
            <li><a href="/research/recursive-context">Recursive Context</a></li>
            <li><a href="/research/edge-delivery">Edge Delivery</a></li>
            <li><a href="/research/skill-doctor">Skill Doctor</a></li>
            <li><a href="/blog/ephemeral-sandboxes">Sandboxes</a></li>
            <li>
              <a
                href="https://docs.kalarislabs.com"
                target="_blank"
                rel="noopener noreferrer"
              >
                Docs <span class="arrow-glyph" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <span class="footer-nav-heading">Publications</span>
          <ul class="footer-nav-list" role="list">
            <li><a href="/research">Research Notes</a></li>
            <li><a href="/blog">Technical Blog</a></li>
            <li><a href="/manifesto">The Manifesto</a></li>
            <li><a href="/rss.xml">RSS Feed</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <span class="footer-nav-heading">Company</span>
          <ul class="footer-nav-list" role="list">
            <li><a href="/company">About</a></li>
            <li><a href="/team">Research Team</a></li>
            <li>
              <a href="/company/careers" class="careers-nav-link">
                <span>Careers</span>
                <span class="hiring-tag">Hiring</span>
              </a>
            </li>
            <li>
              <a href="mailto:contact@kalarislabs.com">
                Contact <span class="arrow-glyph" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-nav-col">
          <span class="footer-nav-heading">Community</span>
          <ul class="footer-nav-list" role="list">
            <li>
              <a
                href="https://github.com/KalarisLabs"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub <span class="arrow-glyph" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/company/kalarislabs"
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn <span class="arrow-glyph" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://twitter.com/kalarislabs"
                target="_blank"
                rel="noopener noreferrer"
              >
                X / Twitter <span class="arrow-glyph" aria-hidden="true">↗</span
                >
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    {/* Bottom Bar: Copyright & Compliance */}
    <div class="footer-bottom-bar">
      <div class="footer-bottom-left">
        <p class="footer-copyright">
          © {year} Kalaris Labs Inc. All rights reserved.
        </p>
        <span class="footer-divider-dot" aria-hidden="true">·</span>
        <span class="footer-edge-badge">Edge: Cloudflare Workers</span>
      </div>

      <div class="footer-bottom-right">
        <a href="/manifesto">Manifesto</a>
        <a href="/rss.xml">RSS</a>
        <button
          type="button"
          data-analytics-preferences
          class="footer-pref-btn"
        >
          Analytics preferences
        </button>
      </div>
    </div>
  </div>
</footer>
