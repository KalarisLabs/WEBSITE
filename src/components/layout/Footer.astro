---
const docsUrl =
  import.meta.env.PUBLIC_DOCS_URL ?? 'https://docs.kalarislabs.com';
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="content-column">
    <div class="footer-mark">
      <img src="/kalaris-logo-geometric.png" alt="" width="42" height="42" /><p>
        Because the next breakthrough can come from anywhere.
      </p>
    </div>
    <div class="footer-links">
      <a href="/research">Research</a><a href="/blog">Blog</a><a
        href="/company/careers">Careers</a
      ><a href={docsUrl}>Docs ↗</a><a href="mailto:contact@kalarislabs.com"
        >Email ↗</a
      ><button type="button" data-analytics-preferences
        >Analytics preferences</button
      >
    </div>
    <p class="footer-meta">
      © {year} Kalaris Labs · Recursive self-improving infrastructure for scientific
      research.
    </p>
  </div>
</footer>
