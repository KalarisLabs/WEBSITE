---
const docsUrl =
  import.meta.env.PUBLIC_DOCS_URL ?? 'https://docs.kalarislabs.com';
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/blog', label: 'Blog' },
  { href: '/manifesto', label: 'Manifesto' },
  { href: '/team', label: 'Our team' },
  { href: '/company', label: 'Company' },
];
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <nav class="nav-rail" aria-label="Primary navigation">
    <a href="/" class="brand" aria-label="Kalaris Labs home">
      <img src="/kalaris-logo-geometric.png" alt="" width="36" height="36" />
      <span>Kalaris Labs</span>
    </a>

    <div class="rail-links">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['rail-link', isActive(item.href) && 'is-active']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span />
            {item.label}
          </a>
        ))
      }
      <a href={docsUrl} class="rail-link"
        ><span></span>Docs <b aria-hidden="true">↗</b></a
      >
    </div>

    {
      currentPath === '/' && (
        <div class="page-index" aria-label="On this page">
          <p>On this page</p>
          <a href="#mission" class="is-active">
            Mission
          </a>
          <a href="#problem">What we do</a>
          <a href="#system">The system</a>
          <a href="#culture">Culture</a>
          <a href="#horizon">The horizon</a>
        </div>
      )
    }

    <p class="rail-note">
      Scientific infrastructure<br />for everyone, everywhere.
    </p>
  </nav>

  <div class="mobile-bar">
    <a href="/" class="brand" aria-label="Kalaris Labs home"
      ><img
        src="/kalaris-logo-geometric.png"
        alt=""
        width="32"
        height="32"
      /><span>Kalaris Labs</span></a
    >
    <details class="mobile-menu">
      <summary aria-label="Open navigation menu"
        ><span></span><span></span></summary
      >
      <div>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}<a
          href={docsUrl}>Documentation ↗</a
        >
      </div>
    </details>
  </div>
</header>
