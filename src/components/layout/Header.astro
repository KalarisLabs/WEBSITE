---
import { HookSidebar } from '../ui/hook-sidebar';

const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/blog', label: 'Blog' },
  { href: '/manifesto', label: 'Manifesto' },
  { href: '/team', label: 'Team' },
  { href: '/fellowship', label: 'Fellowship' },
  { href: '/careers', label: 'Careers' },
];
const activeHref = nav.find((item) =>
  item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href),
)?.href;
const pageSections = [
  { href: '#mission', label: 'Mission' },
  { href: '#partners', label: 'Partners' },
  { href: '#research', label: 'Research' },
  { href: '#fellowship', label: 'Fellowship' },
  { href: '#careers', label: 'Careers' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="site-header">
  <div class="nav-rail">
    <a href="/" class="brand" aria-label="Kalaris Labs home">
      <img
        src="/kalaris-wordmark.png"
        alt="Kalaris Labs"
        width="184"
        height="56"
      />
    </a>

    <HookSidebar
      client:load
      className="rail-nav"
      aria-label="Primary navigation"
      items={nav}
      activeHref={activeHref}
      highlight
      itemClassName="rail-nav-item"
    />

    {
      currentPath === '/' && (
        <HookSidebar
          client:idle
          className="rail-page-index"
          label="On this page"
          items={pageSections}
          spy
          itemClassName="rail-index-item"
        />
      )
    }

    <p class="rail-note">
      Infrastructure<br />for the agentic era.
    </p>
  </div>

  <div class="mobile-bar">
    <a href="/" class="brand" aria-label="Kalaris Labs home"
      ><img
        src="/kalaris-wordmark.png"
        alt="Kalaris Labs"
        width="160"
        height="48"
      /></a
    >
    <details class="mobile-menu">
      <summary aria-label="Open navigation menu"
        ><span></span><span></span></summary
      >
      <nav aria-label="Primary navigation">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.href === activeHref ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
