---
const docsUrl =
  import.meta.env.PUBLIC_DOCS_URL ?? 'https://docs.kalarislabs.com';
---

<header
  class="bg-background/80 border-border fixed top-0 right-0 left-0 z-50 border-b backdrop-blur-lg"
>
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-2xl font-bold"> Kalaris Labs </a>

      <div class="hidden items-center space-x-8 md:flex">
        <a
          href="#features"
          class="text-foreground/80 hover:text-foreground transition-colors"
        >
          Features
        </a>
        <a
          href="#about"
          class="text-foreground/80 hover:text-foreground transition-colors"
        >
          About
        </a>
        <a
          href="/blog"
          class="text-foreground/80 hover:text-foreground transition-colors"
          >Blog</a
        >
        <a
          href="/research"
          class="text-foreground/80 hover:text-foreground transition-colors"
          >Research</a
        >
        <a
          href="#contact"
          class="text-foreground/80 hover:text-foreground transition-colors"
        >
          Contact
        </a>
        <a
          href={docsUrl}
          class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-4 py-2 transition-colors"
        >
          Documentation
        </a>
      </div>

      <a class="md:hidden" href="#contact" aria-label="Contact Kalaris Labs">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </a>
    </div>
  </nav>
</header>
