---

---

<button
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Light theme"
  title="Switch between dark and light"
  class="theme-button"
  data-theme-toggle
>
  <svg
    class="theme-icon theme-icon-moon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg
    class="theme-icon theme-icon-sun"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'kalaris:theme';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  if (toggle) {
    const apply = (light: boolean) => {
      if (light) root.dataset.theme = 'light';
      else delete root.dataset.theme;
      toggle.setAttribute('aria-checked', String(light));
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', light ? '#f7f7f5' : '#08080a');
    };

    apply(root.dataset.theme === 'light');

    toggle.addEventListener('click', () => {
      const light = toggle.getAttribute('aria-checked') !== 'true';
      apply(light);
      try {
        localStorage.setItem(STORAGE_KEY, light ? 'light' : 'dark');
      } catch {
        /* storage unavailable; the theme still applies for this page */
      }
    });
  }
</script>
