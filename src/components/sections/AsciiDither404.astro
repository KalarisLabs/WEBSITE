---
// Animated ASCII rendering of "404": the glyphs are sampled into a character
// grid, lit by a moving light, and shaded with a 4x4 ordered (Bayer) dither.
---

<div class="ascii-404" data-ascii-404 aria-hidden="true">
  <pre class="ascii-404-art"></pre>
</div>

<script>
  // Dark to bright. The dither decides which neighbouring step each cell uses.
  const RAMP = ' .:-=+*%#@';
  const BAYER = [
    [0, 8, 2, 10],
    [12, 4, 14, 6],
    [3, 11, 1, 9],
    [15, 7, 13, 5],
  ].map((row) => row.map((v) => (v + 0.5) / 16));

  function setup(root: HTMLElement) {
    const pre = root.querySelector('pre');
    if (!pre) return;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    let cols = 0;
    let rows = 0;
    let mask = new Float32Array(0);
    const pointer = { x: 0.62, y: 0.35, active: false };

    // Rasterise "404" into a coverage mask at the grid's resolution.
    function measure() {
      const probe = document.createElement('span');
      probe.textContent = 'M'.repeat(20);
      pre!.appendChild(probe);
      const charW = probe.getBoundingClientRect().width / 20;
      const lineH = parseFloat(getComputedStyle(pre!).lineHeight) || charW * 2;
      probe.remove();

      const width = root.clientWidth;
      cols = Math.max(24, Math.min(160, Math.floor(width / charW)));
      // Narrow screens get a taller grid so the glyphs keep enough resolution.
      const heightRatio = cols < 90 ? 0.62 : 0.42;
      rows = Math.max(12, Math.round((cols * charW * heightRatio) / lineH));

      const canvas = document.createElement('canvas');
      canvas.width = cols;
      canvas.height = rows;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;
      // Cells are taller than wide, so squash the glyphs to keep proportions.
      const aspect = lineH / charW;
      ctx.save();
      ctx.scale(1, 1 / aspect);
      ctx.fillStyle = '#fff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      const size = rows * aspect * 0.92;
      ctx.font = `800 ${size}px Manrope, ui-sans-serif, system-ui, sans-serif`;
      const textWidth = ctx.measureText('404').width;
      const fit = Math.min(1, (cols * 0.92) / textWidth);
      ctx.font = `800 ${size * fit}px Manrope, ui-sans-serif, system-ui, sans-serif`;
      ctx.fillText('404', cols / 2, (rows * aspect) / 2);
      ctx.restore();

      const data = ctx.getImageData(0, 0, cols, rows).data;
      mask = new Float32Array(cols * rows);
      for (let i = 0; i < mask.length; i++) mask[i] = (data[i * 4] ?? 0) / 255;
    }

    function frame(time: number) {
      const t = time / 1000;
      // The light drifts on its own and leans towards the pointer.
      const lx = pointer.active ? pointer.x : 0.5 + Math.sin(t * 0.45) * 0.35;
      const ly = pointer.active ? pointer.y : 0.45 + Math.cos(t * 0.6) * 0.3;
      let out = '';
      for (let y = 0; y < rows; y++) {
        const ny = y / rows;
        for (let x = 0; x < cols; x++) {
          const nx = x / cols;
          const m = mask[y * cols + x] ?? 0;
          const dx = nx - lx;
          const dy = (ny - ly) * 0.6;
          const light = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) * 1.6);
          // Faint scanning bands keep the empty field alive.
          const field =
            0.07 +
            0.07 * Math.sin(nx * 11 + t * 1.3) * Math.cos(ny * 7 - t * 0.9);
          const glyph = m * (0.4 + 0.6 * light);
          const v = Math.min(1, Math.max(0, glyph + field * (1 - m)));
          const level =
            v * (RAMP.length - 1) + (BAYER[y & 3]?.[x & 3] ?? 0.5) - 0.5;
          out +=
            RAMP[Math.max(0, Math.min(RAMP.length - 1, Math.round(level)))];
        }
        out += '\n';
      }
      pre!.textContent = out;
    }

    let raf = 0;
    function loop(time: number) {
      frame(time);
      raf = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(raf);
      measure();
      if (reduceMotion) frame(0);
      else raf = requestAnimationFrame(loop);
    }

    root.addEventListener('pointermove', (event) => {
      const box = root.getBoundingClientRect();
      pointer.x = (event.clientX - box.left) / box.width;
      pointer.y = (event.clientY - box.top) / box.height;
      pointer.active = true;
    });
    root.addEventListener('pointerleave', () => {
      pointer.active = false;
    });

    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 120);
    }).observe(root);

    // Wait for Manrope so the glyphs are sampled in the brand face.
    document.fonts.ready.then(start, start);
  }

  document
    .querySelectorAll<HTMLElement>('[data-ascii-404]')
    .forEach((root) => setup(root));
</script>

<style>
  .ascii-404 {
    width: 100%;
    overflow: hidden;
    user-select: none;
  }
  .ascii-404-art {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(7px, 0.78vw, 11px);
    line-height: 1.15;
    letter-spacing: 0;
    white-space: pre;
  }
</style>
