---
import { POSTINGS } from '../../data/careers';
---

<section class="careers-section" id="careers" aria-labelledby="careers-heading">
  <div class="content-column">
    <h2 id="careers-heading" class="careers-heading">Careers</h2>
    <a
      href="/careers"
      class="careers-card careers-card-wrapper"
      aria-label="Careers at Kalaris Labs"
    >
      <img
        src="/images/careers-graphic.webp"
        alt="Careers at Kalaris Labs: let's build the future of agentic infrastructure"
        width="1728"
        height="910"
        class="careers-card-img"
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="careers-apply-box">
      <p class="careers-apply-text">
        We are building a small applied AI research team. {
          POSTINGS.length === 1
            ? 'Applications are open.'
            : `${POSTINGS.length} postings are open.`
        }
      </p>
      <a href="/careers" class="button-apply">
        View open positions <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
