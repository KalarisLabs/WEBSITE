---
const companies = [
  {
    id: 'anthropic',
    name: 'Anthropic',
    logo: '/images/logos/anthropic.svg',
    isWordmark: false,
    width: 22,
    height: 22,
  },
  {
    id: 'openai',
    name: 'OpenAI',
    logo: '/images/logos/openai.svg',
    isWordmark: false,
    width: 22,
    height: 22,
  },
  {
    id: 'cloudflare',
    name: 'Cloudflare',
    logo: '/images/logos/cloudflare.svg',
    isWordmark: false,
    width: 26,
    height: 18,
  },
  {
    id: 'mintlify',
    name: 'Mintlify',
    logo: '/images/logos/mintlify.svg',
    isWordmark: false,
    width: 20,
    height: 20,
  },
  {
    id: 'posthog',
    name: 'PostHog',
    logo: '/images/logos/posthog.svg',
    isWordmark: false,
    width: 26,
    height: 18,
  },
  {
    id: 'e2b',
    name: 'E2B',
    logo: '/images/logos/e2b.svg',
    isWordmark: true,
    width: 82,
    height: 24,
  },
  {
    id: 'datadog',
    name: 'Datadog',
    logo: '/images/logos/datadog.svg',
    isWordmark: false,
    width: 22,
    height: 22,
  },
  {
    id: 'workos',
    name: 'WorkOS',
    logo: '/images/logos/workos.svg',
    isWordmark: false,
    width: 22,
    height: 20,
  },
  {
    id: 'grafana',
    name: 'Grafana',
    logo: '/images/logos/grafana.svg',
    isWordmark: false,
    width: 22,
    height: 22,
  },
];

// Duplicate items for a smooth, seamless infinite horizontal loop
const marqueeItems = [...companies, ...companies, ...companies];
---

<section class="trusted-section" id="partners" aria-label="Trusted by">
  <div class="content-column">
    <div class="trusted-header">
      <h2 class="trusted-simple-heading">Trusted by</h2>
    </div>
  </div>

  {/* Infinite horizontal looping marquee */}
  <div
    class="trusted-marquee-container"
    role="region"
    aria-label="Trusted companies"
  >
    <div class="trusted-marquee-track">
      {
        marqueeItems.map((company, index) => (
          <div
            class="trusted-marquee-item"
            data-company={company.id}
            aria-hidden={index >= companies.length ? 'true' : undefined}
          >
            {company.isWordmark ? (
              <img
                src={company.logo}
                alt={company.name}
                class={`trusted-wordmark brand-${company.id}`}
                loading="lazy"
                width={company.width}
                height={company.height}
              />
            ) : (
              <div class="trusted-combo">
                <img
                  src={company.logo}
                  alt=""
                  class={`trusted-icon brand-${company.id}`}
                  loading="lazy"
                  width={company.width}
                  height={company.height}
                  aria-hidden="true"
                />
                <span class="trusted-label">{company.name}</span>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
