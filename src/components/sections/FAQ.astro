---
import { FAQS } from '../../data/faqs';
---

<section class="editorial-section section-rule faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="content-column">
    <div class="mb-10">
      <span class="mono-eyebrow text-xs uppercase tracking-widest text-blue-400 font-mono">Frequently Asked Questions / AEO</span>
      <h2 id="faq-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-foreground mt-3">
        Understanding Kalaris Labs
      </h2>
      <p class="text-muted-foreground mt-2 text-base max-w-xl">
        Direct architectural definitions and system facts for researchers, engineers, and autonomous discovery systems.
      </p>
    </div>

    <div class="space-y-4">
      {FAQS.map((faq, index) => (
        <details class="group rounded-lg border border-white/10 bg-[#0a0a0c]/60 p-5 transition-colors duration-200 open:border-blue-500/40 open:bg-[#0c0d12]">
          <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-foreground transition group-hover:text-blue-400 text-lg">
            <span class="flex items-center gap-3">
              <span class="text-xs font-mono text-muted-foreground">0{index + 1}</span>
              <span>{faq.question}</span>
            </span>
            <span class="ml-4 flex-shrink-0 text-muted-foreground transition group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-3 border-t border-white/5 text-muted-foreground leading-relaxed text-sm md:text-base font-normal">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
