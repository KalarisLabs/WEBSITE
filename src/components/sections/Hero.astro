---
// Hero section with animations
---

<section id="hero" class="flex min-h-screen items-center justify-center pt-20">
  <div class="container mx-auto px-4 text-center">
    <h1
      class="from-primary to-primary/60 mb-6 bg-gradient-to-r bg-clip-text text-5xl font-bold text-transparent md:text-7xl"
    >
      Building the Future of Technology
    </h1>
    <p class="text-muted-foreground mx-auto mb-8 max-w-2xl text-xl md:text-2xl">
      Kalaris Labs creates innovative solutions that push the boundaries of
      what's possible.
    </p>
    <div class="flex flex-col justify-center gap-4 sm:flex-row">
      <a
        href="#contact"
        class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-8 py-3 text-lg transition-colors"
      >
        Get Started
      </a>
      <a
        href="#features"
        class="bg-secondary text-secondary-foreground hover:bg-secondary/90 rounded-lg px-8 py-3 text-lg transition-colors"
      >
        Learn More
      </a>
    </div>
  </div>
</section>
