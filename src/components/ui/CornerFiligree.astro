---
/**
 * CornerFiligree.astro
 * Classical typographic book ornament / fleuron corner filigree.
 * Matches editorial monograph printing traditions and reference design.
 */
interface Props {
  className?: string;
  size?: number;
}

const { className = '', size = 38 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  class={`corner-filigree ${className}`}
  aria-hidden="true"
>
  <!-- Outer right-angle boundary with corner finial accents -->
  <path
    d="M4 22 V8 C4 5.79 5.79 4 8 4 H22"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
  />
  <path
    d="M8 18 V10 C8 8.9 8.9 8 10 8 H18"
    stroke="currentColor"
    stroke-width="0.85"
    stroke-linecap="round"
    stroke-dasharray="1.5 2"
  />

  <!-- Corner finial nodes -->
  <circle cx="4" cy="24" r="1.5" fill="currentColor" />
  <circle cx="24" cy="4" r="1.5" fill="currentColor" />
  <circle cx="4" cy="4" r="1.75" fill="currentColor" />

  <!-- Inward curling foliage tendrils -->
  <path
    d="M7 7 C12 12, 16 14, 24 14 C18 18, 16 22, 15 28 C14 22, 10 18, 7 7 Z"
    stroke="currentColor"
    stroke-width="1"
    fill="currentColor"
    fill-opacity="0.16"
  />
  <path
    d="M14 24 C14 16, 16 14, 24 14"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
  />

  <!-- Floral spiral loops -->
  <path
    d="M10 26 C12 28, 16 28, 18 25 C20 22, 19 19, 16 19 C13 19, 12 21, 13 23"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
  />
  <path
    d="M26 10 C28 12, 28 16, 25 18 C22 20, 19 19, 19 16 C19 13, 21 12, 23 13"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
  />

  <!-- Central accent fleuron leaf -->
  <path
    d="M21 21 C25 25, 28 27, 32 28 C28 30, 26 33, 25 37 C24 33, 22 30, 18 28 C22 27, 24 24, 21 21 Z"
    stroke="currentColor"
    stroke-width="0.9"
    fill="currentColor"
    fill-opacity="0.22"
  />
  <circle cx="28" cy="28" r="1.25" fill="currentColor" />
</svg>
