---
import type { PublishingCollection, PublishingEntry } from '../lib/content';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from './Layout.astro';

interface Props {
  entry: PublishingEntry;
  collection: PublishingCollection;
}

const { entry, collection } = Astro.props;
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.socialImage}
>
  <Header />
  <main class="container mx-auto min-h-[70vh] max-w-3xl px-4 pt-32 pb-20">
    <a class="text-primary text-sm hover:underline" href={`/${collection}`}
      >&larr; Back to {collection}</a
    >
    <article class="mt-8">
      <header class="border-border border-b pb-8">
        <h1 class="text-4xl font-bold md:text-6xl">{entry.data.title}</h1>
        <p class="text-muted-foreground mt-5 text-xl">
          {entry.data.description}
        </p>
        <time
          class="text-muted-foreground mt-5 block text-sm"
          datetime={entry.data.publishDate.toISOString()}
        >
          {
            entry.data.publishDate.toLocaleDateString('en', {
              dateStyle: 'long',
            })
          }
        </time>
      </header>
      <div
        class="prose prose-headings:text-foreground prose-p:text-foreground/85 mt-10 max-w-none"
      >
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>
