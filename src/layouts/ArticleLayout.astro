---
import {
  coverTransitionStyle,
  entryPath,
  getPublishedEntries,
  type PublishingCollection,
  type PublishingEntry,
} from '../lib/content';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { HookSidebar } from '../components/ui/hook-sidebar';
import Layout from './Layout.astro';
import { entryOgImage } from '../lib/seo/og';
import { getPerson, initials, people } from '../data/people';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: PublishingEntry;
  collection: PublishingCollection;
  headings?: Heading[];
}

const { entry, collection, headings = [] } = Astro.props;
const authors = entry.data.authors.map((slug) => getPerson(slug) ?? people[0]!);
const author = authors[0]!;
const authorNames = authors.map((person) => person.name);
const bibtexName = (name: string) => {
  const parts = name.split(' ');
  return `${parts.at(-1)}, ${parts.slice(0, -1).join(' ')}`;
};
const isResearch = collection === 'research';
const sectionName = isResearch ? 'Research' : 'Blog';
const backUrl = `/${collection}`;
const backLabel = isResearch ? 'All research' : 'All articles';
const primaryTag = entry.data.tags[0] ?? (isResearch ? 'research' : 'systems');

const formattedDate = entry.data.publishDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

// Filter headings for TOC (h2 and h3)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Estimate reading time
const wordCount = entry.body ? entry.body.trim().split(/\s+/).length : 500;
const readingTimeMinutes = Math.max(1, Math.round(wordCount / 220));
const tocItems = tocHeadings.map((heading) => ({
  label: heading.text,
  href: `#${heading.slug}`,
  depth: heading.depth - 2,
}));
const markdownPath = `/${collection}/${entry.id}.md`;

const canonicalUrl = new URL(
  `/${collection}/${entry.id}`,
  Astro.site,
).toString();
const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(entry.data.title);
// Related reading: same-section entries by shared tags, topped up from the
// other section so every article links to at least three others.
const tagOverlap = (candidate: PublishingEntry) =>
  candidate.data.tags.filter((tag) => entry.data.tags.includes(tag)).length;
const byRelevance = (a: PublishingEntry, b: PublishingEntry) =>
  tagOverlap(b) - tagOverlap(a) ||
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
const otherCollection: PublishingCollection = isResearch ? 'blog' : 'research';
const sameSection = (await getPublishedEntries(collection)).filter(
  (candidate) => candidate.id !== entry.id,
);
const relatedEntries = [
  ...[...sameSection]
    .sort(byRelevance)
    .map((related) => ({ related, section: collection })),
  ...(await getPublishedEntries(otherCollection))
    .sort(byRelevance)
    .map((related) => ({ related, section: otherCollection })),
].slice(0, 3);

// Chronological neighbours within the section.
const timeline = [entry, ...sameSection].sort(
  (a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf(),
);
const position = timeline.findIndex((candidate) => candidate.id === entry.id);
const olderEntry = timeline[position - 1];
const newerEntry = timeline[position + 1];

const bibtex = `@article{kalaris${entry.data.publishDate.getUTCFullYear()}_${entry.id.replace(/[^a-zA-Z0-9]/g, '_')},
  title = {${entry.data.title}},
  author = {${authors.map((person) => bibtexName(person.name)).join(' and ')}},
  journal = {Kalaris Labs Research Notes},
  year = {${entry.data.publishDate.getUTCFullYear()}},
  url = {${canonicalUrl}}
}`;
---

<Layout
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  image={entryOgImage(collection, entry)}
  type="article"
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  section={sectionName}
  authors={authors}
  wordCount={wordCount}
  markdownPath={markdownPath}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: sectionName, url: `/${collection}` },
    { name: entry.data.title, url: `/${collection}/${entry.id}` },
  ]}
>
  <Header />

  <main id="main-content" class="article-page-main">
    <div class="article-container">
      {/* Top Header Section (Inspired by Reference 1) */}
      <header class="article-header">
        <a href={backUrl} class="article-back-link">
          <span aria-hidden="true">←</span>
          {backLabel}
        </a>

        <div class="article-meta-eyebrow">
          <span class="meta-tag">{primaryTag.replaceAll('-', ' ')}</span>
          <span class="meta-slash">/</span>
          <time datetime={entry.data.publishDate.toISOString()}>
            {formattedDate}
          </time>
        </div>

        <h1 class="article-headline">
          {entry.data.title}
        </h1>

        <p class="article-deck">{entry.data.description}</p>

        <div class="article-read-badge">
          <span>{readingTimeMinutes} min read</span>
          {
            entry.data.updatedDate && (
              <span>
                Updated{' '}
                <time datetime={entry.data.updatedDate.toISOString()}>
                  {entry.data.updatedDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              </span>
            )
          }
        </div>
      </header>

      {/* Full-width Divider Line */}
      <hr class="article-header-divider" />

      {/* 3-Column Editorial Grid (Inspired by Reference 1) */}
      <div class="article-layout-grid">
        {/* Left Column: Author Bio & Social Sharing (Sticky) */}
        <aside class="article-left-sidebar">
          <a class="author-block" href={`/team/${author.slug}`} rel="author">
            {
              author.image ? (
                <img
                  src={author.image}
                  alt={author.name}
                  class="author-avatar-img"
                  width="48"
                  height="48"
                  loading="lazy"
                />
              ) : (
                <span
                  class="author-avatar-img person-monogram"
                  aria-hidden="true"
                >
                  {initials(author.name)}
                </span>
              )
            }
            <div class="author-meta-block">
              <span class="author-display-name">{authorNames.join(', ')}</span>
              <span class="author-display-role">
                {author.byline ?? author.role}
              </span>
            </div>
          </a>

          <div class="social-share-widget">
            <span class="share-heading">SHARE THIS ARTICLE</span>
            <div class="share-icon-row">
              {/* LinkedIn */}
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-icon-btn"
                title="Share on LinkedIn"
                aria-label="Share on LinkedIn"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                  ></path>
                </svg>
              </a>

              {/* X / Twitter */}
              <a
                href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-icon-btn"
                title="Share on X"
                aria-label="Share on X"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  ></path>
                </svg>
              </a>

              {/* Hacker News */}
              <a
                href={`https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodedTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-icon-btn"
                title="Share on Hacker News"
                aria-label="Share on Hacker News"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M0 0v24h24v-24h-24zm13.15 13.916v5.284h-2.316v-5.284l-4.284-8.116h2.645l2.81 5.674 2.808-5.674h2.622l-4.285 8.116z"
                  ></path>
                </svg>
              </a>

              {/* Copy URL */}
              <button
                type="button"
                class="share-icon-btn copy-url-trigger"
                title="Copy article link"
                aria-label="Copy article link"
                data-url={canonicalUrl}
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                  ></path>
                  <path
                    d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                  ></path>
                </svg>
              </button>
            </div>
            <span class="copy-notice" id="copy-notice" aria-live="polite"
            ></span>
          </div>
        </aside>

        {/* Center Column: Article Prose */}
        <div class="article-center-content">
          {
            entry.data.socialImage && (
              <div
                class="article-featured-banner"
                style={coverTransitionStyle(collection, entry)}
              >
                <img
                  src={entry.data.socialImage}
                  alt={entry.data.title}
                  class="article-featured-image"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            )
          }

          <div class="article-prose-body">
            <slot />
          </div>

          {
            isResearch && (
              <section
                class="research-citation-card"
                aria-labelledby="citation-heading"
              >
                <h2 id="citation-heading" class="citation-title">
                  Cite this research note
                </h2>
                <p class="citation-desc">
                  BibTeX entry for academic citations, literature trackers, and
                  generative research synthesizers:
                </p>
                <pre class="citation-pre">
                  <code>{bibtex}</code>
                </pre>
              </section>
            )
          }

          {
            (olderEntry || newerEntry) && (
              <nav
                class="article-pager"
                aria-label={`More ${sectionName.toLowerCase()} posts`}
              >
                {olderEntry && (
                  <a href={entryPath(collection, olderEntry)} rel="prev">
                    <span>Previous</span>
                    {olderEntry.data.title}
                  </a>
                )}
                {newerEntry && (
                  <a
                    class="article-pager-next"
                    href={entryPath(collection, newerEntry)}
                    rel="next"
                  >
                    <span>Next</span>
                    {newerEntry.data.title}
                  </a>
                )}
              </nav>
            )
          }

          {
            relatedEntries.length > 0 && (
              <section
                class="article-related-section"
                aria-labelledby="related-heading"
              >
                <p class="eyebrow">Continue reading</p>
                <h2 id="related-heading">Related reading</h2>
                <div class="article-related-grid">
                  {relatedEntries.map(({ related, section }) => (
                    <a
                      class="article-related-card"
                      href={entryPath(section, related)}
                    >
                      {related.data.socialImage && (
                        <div
                          class="article-related-thumb"
                          style={coverTransitionStyle(section, related)}
                        >
                          <img
                            src={related.data.socialImage}
                            alt=""
                            width="320"
                            height="180"
                            loading="lazy"
                          />
                        </div>
                      )}
                      <div class="article-related-body">
                        <span>
                          {related.data.tags[0]?.replaceAll('-', ' ')}
                        </span>
                        <h3>{related.data.title}</h3>
                        <p>{related.data.description}</p>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        {/* Right Column: Table of Contents & Newsletter (Sticky) */}
        <aside class="article-right-sidebar">
          {
            tocItems.length > 0 && (
              <HookSidebar
                client:idle
                className="article-toc"
                label="On this page"
                items={tocItems}
                spy
                itemClassName="article-toc-item"
              />
            )
          }

          <div class="article-follow-widget">
            <span class="newsletter-badge">Follow the research</span>
            <p class="newsletter-prompt">
              New notes and engineering posts are published to our feeds.
            </p>
            <div class="article-follow-links">
              <a href={isResearch ? '/research/rss.xml' : '/blog/rss.xml'}>
                {sectionName} RSS
              </a>
              <a href={markdownPath}>Read as Markdown</a>
              <a href="mailto:hello@kalarislabs.com">
                hello@kalarislabs.com <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Copy URL with visual tooltip feedback
  const copyBtn =
    document.querySelector<HTMLButtonElement>('.copy-url-trigger');
  const notice = document.getElementById('copy-notice');

  if (copyBtn && notice) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        notice.textContent = 'Link copied!';
        notice.classList.add('is-visible');
        setTimeout(() => {
          notice.textContent = '';
          notice.classList.remove('is-visible');
        }, 2200);
      } catch {
        notice.textContent = 'Failed to copy';
      }
    });
  }
</script>
