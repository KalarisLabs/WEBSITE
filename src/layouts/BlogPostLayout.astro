---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ShareArticleBar from '@/components/ui/ShareArticleBar';
import TableOfContents, { type TocHeading } from '@/components/ui/TableOfContents';
import { generateOrganizationSchema } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  authorRole?: string;
  authorAvatar?: string;
  readingTime?: string;
  category?: string;
  tags?: string[];
  tldr?: string;
  image?: string;
  headings?: TocHeading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'Kalaris Labs Research Team',
  authorRole = 'Research Scientist',
  authorAvatar = '/sayan-chowdhury.jpg',
  readingTime = '5 min read',
  category = 'Research',
  tags = [],
  tldr,
  image,
  headings = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kalarislabs.com').toString();

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).toUpperCase();

const formattedUpdatedDate = updatedDate
  ? updatedDate.toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    }).toUpperCase()
  : null;

// E-E-A-T & Google Search SEO Schema Architecture
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: [
    {
      '@type': 'Person',
      name: author,
      jobTitle: authorRole,
      worksFor: {
        '@type': 'Organization',
        name: 'Kalaris Labs',
      },
    },
  ],
  publisher: generateOrganizationSchema(),
  mainEntityOfPage: canonicalURL,
  image: image ? new URL(image, canonicalURL).toString() : undefined,
};

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://kalarislabs.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blogs',
      item: 'https://kalarislabs.com/blogs',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalURL,
    },
  ],
};
---

<BaseLayout
  title={`${title} | Kalaris Labs`}
  description={description}
  article={true}
  schema={[generateOrganizationSchema(), blogSchema, breadcrumbsSchema]}
>
  <Header currentPath="/blogs" />

  <main id="main-content" class="min-h-screen bg-black text-neutral-100 pt-8 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Back Link & Breadcrumb Nav -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <a
          href="/blogs"
          class="inline-flex items-center gap-1 text-xs font-mono text-neutral-400 hover:text-white transition-colors no-underline group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span>Back to all articles</span>
        </a>
      </nav>

      <!-- 1. Top Article Header: Large H1 + Publication / Update Timestamps (Reference 2) -->
      <header class="mb-10 max-w-4xl">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#1B4D3E]/30 text-emerald-300 border border-[#1B4D3E]/60">
            {category}
          </span>
          {readingTime && (
            <span class="text-xs font-mono text-neutral-400">· {readingTime}</span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold tracking-tight text-white leading-[1.12] mb-4">
          {title}
        </h1>

        <div class="text-[11px] sm:text-xs font-mono tracking-wider uppercase text-neutral-400 flex flex-wrap items-center gap-x-2 gap-y-1">
          <span>PUBLISHED {formattedPubDate}</span>
          {formattedUpdatedDate && (
            <>
              <span class="text-neutral-600">/</span>
              <span class="text-neutral-300">UPDATED {formattedUpdatedDate}</span>
            </>
          )}
        </div>
      </header>

      <!-- 2. Three-Column Editorial Architecture (Reference 2) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- LEFT COLUMN: Author Profile & Social Share Links (Sticky) -->
        <aside class="lg:col-span-2 hidden lg:block">
          <div class="sticky top-24 space-y-7">
            <!-- Author Profile Card (E-E-A-T Credentialing) -->
            <div class="flex items-center gap-3">
              {authorAvatar ? (
                <img
                  src={authorAvatar}
                  alt={author}
                  class="w-11 h-11 rounded-full object-cover border border-neutral-700 bg-neutral-800"
                  loading="lazy"
                />
              ) : (
                <div class="w-11 h-11 rounded-full bg-[#1B4D3E] text-white font-mono font-bold text-sm flex items-center justify-center border border-emerald-500/40">
                  {author.slice(0, 2).toUpperCase()}
                </div>
              )}
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-neutral-100 leading-snug">
                  {author}
                </span>
                <span class="text-xs text-neutral-400 leading-tight">
                  {authorRole}
                </span>
              </div>
            </div>

            <!-- Social Share Links with Tooltip & Copy Link -->
            <div class="pt-2 border-t border-neutral-800/80">
              <ShareArticleBar client:load title={title} />
            </div>
          </div>
        </aside>

        <!-- CENTER COLUMN: Primary Article Reader & Content Container -->
        <article class="lg:col-span-7 col-span-1 min-w-0">
          
          <!-- Featured Header Banner (Reference 2) -->
          <div class="rounded-2xl overflow-hidden border border-neutral-800/80 bg-neutral-900/60 mb-8 aspect-[16/9] relative shadow-md">
            {image ? (
              <img
                src={image}
                alt={title}
                class="w-full h-full object-cover"
                loading="eager"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-[#0a231b] via-[#10382d] to-[#1a5948] flex items-center justify-center p-8 text-center relative overflow-hidden">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.25)_0%,transparent_70%)] pointer-events-none"></div>
                <div class="relative z-10 max-w-lg px-4 py-3 rounded-xl backdrop-blur-md bg-black/40 border border-white/15 shadow-2xl">
                  <span class="font-sans font-bold text-xl sm:text-2xl text-white tracking-tight leading-tight block">
                    {title}
                  </span>
                  <span class="font-mono text-xs text-emerald-300/80 mt-1 block">
                    KALARIS_LABS // RESEARCH_SPEC
                  </span>
                </div>
              </div>
            )}
          </div>

          <!-- TL;DR / Executive Summary Callout Box (SEO & E-E-A-T direct answer) -->
          {tldr && (
            <section class="rounded-xl p-5 sm:p-6 bg-neutral-900/70 border border-neutral-800 mb-9 relative overflow-hidden" aria-label="Executive Summary">
              <div class="absolute top-0 left-0 w-1 h-full bg-[#1B4D3E]"></div>
              <div class="flex items-center gap-2 mb-2.5">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                  <span class="text-emerald-400">✦</span> SUMMARY
                </span>
              </div>
              <p class="text-sm sm:text-[15px] leading-relaxed text-neutral-200 m-0 font-sans font-normal">
                {tldr}
              </p>
            </section>
          )}

          <!-- Article Markdown Content Slot -->
          <div class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-neutral-800 prose-h2:pb-2.5 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-p:text-neutral-300 prose-p:leading-[1.75] prose-p:text-[16px] prose-a:text-emerald-400 prose-a:no-underline hover:prose-a:underline prose-code:text-emerald-300 prose-code:bg-neutral-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-neutral-900 prose-pre:border prose-pre:border-neutral-800 prose-blockquote:border-l-[#1B4D3E] prose-blockquote:text-neutral-300 prose-blockquote:bg-neutral-900/40 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-table:text-sm prose-th:text-white prose-th:border-b prose-th:border-neutral-700 prose-td:border-b prose-td:border-neutral-800/80">
            <slot />
          </div>

          <!-- Mobile Author Profile & Share Bar (Visible only on mobile / tablet) -->
          <div class="mt-12 pt-6 border-t border-neutral-800 lg:hidden flex flex-col gap-6">
            <div class="flex items-center gap-3">
              {authorAvatar ? (
                <img
                  src={authorAvatar}
                  alt={author}
                  class="w-11 h-11 rounded-full object-cover border border-neutral-700 bg-neutral-800"
                />
              ) : (
                <div class="w-11 h-11 rounded-full bg-[#1B4D3E] text-white font-mono font-bold text-sm flex items-center justify-center">
                  {author.slice(0, 2).toUpperCase()}
                </div>
              )}
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-white">{author}</span>
                <span class="text-xs text-neutral-400">{authorRole}</span>
              </div>
            </div>

            <ShareArticleBar client:load title={title} />
          </div>

          <!-- Tags List -->
          {tags.length > 0 && (
            <div class="mt-10 pt-6 border-t border-neutral-800 flex items-center flex-wrap gap-2">
              <span class="text-xs font-mono uppercase text-neutral-400 mr-2">Tags:</span>
              {tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-neutral-900 border border-neutral-800 text-neutral-300">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </article>

        <!-- RIGHT COLUMN: Sticky Table of Contents & Protocol Access CTA (Reference 2) -->
        <aside class="lg:col-span-3 hidden lg:block">
          <div class="sticky top-24 space-y-8">
            
            <!-- Sticky Table of Contents -->
            {headings && headings.length > 0 && (
              <div class="bg-neutral-950/60 border border-neutral-800/80 rounded-xl p-5 shadow-xs">
                <TableOfContents client:load headings={headings} />
              </div>
            )}

            <!-- Institutional Access / Newsletter Callout Widget -->
            <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5 flex flex-col gap-3.5 shadow-xs">
              <div class="flex flex-col gap-1">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-emerald-400">
                  Institutional Access
                </span>
                <h4 class="text-sm font-semibold text-white m-0">
                  Stay updated on preprints
                </h4>
                <p class="text-xs text-neutral-400 m-0 leading-relaxed">
                  Direct evaluation logs and benchmark updates for researchers.
                </p>
              </div>

              <form
                id="newsletter-sidebar-form"
                action="/api/access"
                method="POST"
                class="flex flex-col gap-2.5"
              >
                <input
                  type="email"
                  required
                  placeholder="Enter research email"
                  class="w-full px-3 py-2 rounded-lg bg-black border border-neutral-800 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-[#1B4D3E] transition-colors"
                />
                <button
                  type="submit"
                  class="w-full py-2 px-3 rounded-lg bg-white text-black font-semibold text-xs hover:bg-neutral-200 transition-colors cursor-pointer"
                >
                  Join Research Dispatch
                </button>
              </form>

              <a
                href="/manifesto"
                class="text-[11px] font-mono text-neutral-400 hover:text-white transition-colors text-center no-underline"
              >
                Read our thesis & manifesto →
              </a>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
