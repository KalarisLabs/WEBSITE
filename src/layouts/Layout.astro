---
import '../styles/global.css';
import AnalyticsConsent from '../components/integrations/AnalyticsConsent.astro';
import AnnouncementBar from '../components/layout/AnnouncementBar.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildOrganizationSchema,
  buildWebsiteSchema,
  type BreadcrumbItem,
  type JsonLd,
} from '../lib/seo/schema';
import { markdownPathFor } from '../lib/seo/markdown';
import {
  isGeneratedOgImage,
  OG_IMAGE_SIZE,
  OG_IMAGE_TYPE,
} from '../lib/seo/og';
import { SITE } from '../lib/seo/site';

interface Props {
  title: string;
  seoTitle?: string | undefined;
  description?: string;
  image?: string | undefined;
  /** Alt text and pixel size for a custom social image. */
  imageAlt?: string | undefined;
  imageSize?: { width: number; height: number } | undefined;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date | undefined;
  tags?: string[];
  section?: 'Blog' | 'Research';
  authorName?: string;
  wordCount?: number;
  breadcrumbs?: BreadcrumbItem[];
  extraSchemas?: JsonLd[];
  noindex?: boolean;
  /** Markdown twin of the page for agents and LLM readers. */
  markdownPath?: string;
}

const {
  title,
  seoTitle,
  description = SITE.description,
  image = SITE.socialImagePath,
  imageAlt,
  imageSize,
  type = 'website',
  publishDate,
  updatedDate,
  tags = [],
  section,
  authorName,
  wordCount,
  breadcrumbs = [],
  extraSchemas = [],
  noindex = false,
  markdownPath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Every indexable page has a Markdown twin generated at build time.
const markdownAlternate = noindex
  ? undefined
  : (markdownPath ?? markdownPathFor(Astro.url.pathname));
const titleForSearch = seoTitle ?? title;
const pageTitle = titleForSearch.includes('Kalaris Labs')
  ? titleForSearch
  : `${titleForSearch} | Kalaris Labs`;
const imageURL = new URL(image, Astro.site);
const isDefaultImage = image === SITE.socialImagePath;
const socialImageAlt = isDefaultImage
  ? SITE.socialImageAlt
  : (imageAlt ?? title);
// Generated images are always 1200x630 JPEGs; see src/lib/seo/og.ts.
const isGeneratedImage = isGeneratedOgImage(image);
const socialImageSize = isGeneratedImage ? OG_IMAGE_SIZE : imageSize;
const schemas: JsonLd[] = [buildOrganizationSchema(), buildWebsiteSchema()];

if (breadcrumbs.length > 0) {
  schemas.push(buildBreadcrumbSchema(breadcrumbs));
}

if (extraSchemas.length > 0) {
  schemas.push(...extraSchemas);
}

if (type === 'article' && publishDate && section) {
  schemas.push(
    buildArticleSchema({
      title,
      description,
      url: canonicalURL.toString(),
      image,
      publishDate,
      updatedDate,
      tags,
      section,
      ...(authorName ? { authorName } : {}),
      ...(wordCount ? { wordCount } : {}),
    }),
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={authorName ?? SITE.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08080a" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      isGeneratedImage && (
        <meta property="og:image:type" content={OG_IMAGE_TYPE} />
      )
    }
    {
      socialImageSize && (
        <>
          <meta
            property="og:image:width"
            content={String(socialImageSize.width)}
          />
          <meta
            property="og:image:height"
            content={String(socialImageSize.height)}
          />
        </>
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:creator" content={SITE.founderTwitter} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- Canonical URL & Alternate Discovery -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="LLM content index"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="Full LLM Context"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kalaris Labs: all posts"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kalaris Labs Research"
      href="/research/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kalaris Labs Blog"
      href="/blog/rss.xml"
    />
    {
      markdownAlternate && (
        <link rel="alternate" type="text/markdown" href={markdownAlternate} />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      type === 'article' && publishDate && (
        <>
          <meta
            property="article:published_time"
            content={publishDate.toISOString()}
          />
          {updatedDate && (
            <meta
              property="article:modified_time"
              content={updatedDate.toISOString()}
            />
          )}
          {tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    {
      type === 'article' && section === 'Research' && (
        <>
          <meta name="citation_title" content={title} />
          <meta
            name="citation_author"
            content={authorName ?? 'Sayan Chowdhury'}
          />
          {publishDate && (
            <meta
              name="citation_publication_date"
              content={publishDate.toISOString().split('T')[0]}
            />
          )}
          <meta
            name="citation_journal_title"
            content="Kalaris Labs Research Notes"
          />
          <meta name="citation_language" content="en" />
          <meta name="citation_abstract" content={description} />
          {tags.length > 0 && (
            <meta name="citation_keywords" content={tags.join('; ')} />
          )}
        </>
      )
    }
    <StructuredData value={schemas} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <AnnouncementBar />
    <slot />
    <AnalyticsConsent />

    <script>
      import Lenis from 'lenis';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1.0,
          touchMultiplier: 1.8,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (href && href !== '#' && href.startsWith('#')) {
              const target = document.querySelector(href);
              if (target) {
                e.preventDefault();
                lenis.scrollTo(target as HTMLElement, { offset: -24 });
              }
            }
          });
        });
      }
    </script>
  </body>
</html>
