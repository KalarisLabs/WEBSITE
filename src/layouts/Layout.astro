---
import '../styles/global.css';
import AnalyticsConsent from '../components/integrations/AnalyticsConsent.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import {
  buildArticleSchema,
  buildOrganizationSchema,
  buildWebsiteSchema,
} from '../lib/seo/schema';
import { SITE } from '../lib/seo/site';

interface Props {
  title: string;
  description?: string;
  image?: string | undefined;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date | undefined;
  tags?: string[];
  section?: 'Blog' | 'Research';
}

const {
  title,
  description = SITE.description,
  image = SITE.socialImagePath,
  type = 'website',
  publishDate,
  updatedDate,
  tags = [],
  section,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title.includes('Kalaris Labs')
  ? title
  : `${title} | Kalaris Labs`;
const schemas = [buildOrganizationSchema(), buildWebsiteSchema()];

if (type === 'article' && publishDate && section) {
  schemas.push(
    buildArticleSchema({
      title,
      description,
      url: canonicalURL.toString(),
      image,
      publishDate,
      updatedDate,
      tags,
      section,
    }),
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content={SITE.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="LLM content index"
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kalaris Labs"
      href="/rss.xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      type === 'article' && publishDate && (
        <>
          <meta
            property="article:published_time"
            content={publishDate.toISOString()}
          />
          {updatedDate && (
            <meta
              property="article:modified_time"
              content={updatedDate.toISOString()}
            />
          )}
          {tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <StructuredData value={schemas} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <AnalyticsConsent />
  </body>
</html>
