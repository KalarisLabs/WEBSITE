---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { generateOrganizationSchema } from '@/lib/seo';

interface Props {
  title: string;
  abstract: string;
  pubDate: Date;
  authors: string[];
  category: string;
  status: string;
  doi?: string;
  arxivId?: string;
  pdfUrl?: string;
  bibtex?: string;
}

const {
  title,
  abstract,
  pubDate,
  authors,
  category,
  status,
  doi,
  arxivId,
  pdfUrl,
  bibtex,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kalarislabs.com').toString();

const paperSchema = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: title,
  description: abstract,
  datePublished: pubDate.toISOString(),
  author: authors.map((name) => ({ '@type': 'Person', name })),
  publisher: generateOrganizationSchema(),
  mainEntityOfPage: canonicalURL,
  about: category,
  sameAs: doi ? `https://doi.org/${doi}` : undefined,
};
---

<BaseLayout title={title} description={abstract} article={true} schema={[generateOrganizationSchema(), paperSchema]}>
  <Header />
  <main id="main-content" class="reading-column paper-main">
    <div class="paper-header">
      <a href="/research" class="back-link">← Back to research publications</a>

      <div class="paper-status-bar">
        <span class="paper-category">{category}</span>
        <span class="paper-status-badge">{status}</span>
        <time datetime={pubDate.toISOString()} class="paper-date">
          {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
        </time>
      </div>

      <h1 class="paper-title">{title}</h1>

      <div class="paper-authors">
        {authors.map((author, index) => (
          <span class="author-name">
            {author}{index < authors.length - 1 ? ', ' : ''}
          </span>
        ))}
      </div>

      <div class="paper-actions">
        {pdfUrl && (
          <a href={pdfUrl} class="action-btn pdf-btn" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            Download PDF
          </a>
        )}
        {arxivId && (
          <a href={`https://arxiv.org/abs/${arxivId}`} class="action-btn arxiv-btn" target="_blank" rel="noopener noreferrer">
            arXiv:{arxivId} ↗
          </a>
        )}
        {doi && (
          <a href={`https://doi.org/${doi}`} class="action-btn doi-btn" target="_blank" rel="noopener noreferrer">
            DOI:{doi} ↗
          </a>
        )}
      </div>
    </div>

    <!-- Abstract -->
    <div class="paper-abstract-box">
      <h2 class="abstract-heading">Abstract</h2>
      <p class="abstract-text">{abstract}</p>
    </div>

    <!-- Main Content -->
    <article class="paper-body">
      <slot />
    </article>

    <!-- BibTeX Citation Block -->
    {bibtex && (
      <div class="bibtex-section">
        <div class="bibtex-header">
          <span class="bibtex-title">BibTeX Citation</span>
          <button type="button" class="copy-bibtex-btn" id="copy-bibtex" data-bibtex={bibtex}>
            Copy BibTeX
          </button>
        </div>
        <pre class="bibtex-code"><code>{bibtex}</code></pre>
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-bibtex');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const bibtex = copyBtn.getAttribute('data-bibtex') || '';
      navigator.clipboard.writeText(bibtex).then(() => {
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = orig;
        }, 2000);
      });
    });
  }
</script>

<style>
  .paper-main {
    padding-block: var(--space-12) var(--space-16);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted-ink);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--kalari-green);
  }

  .paper-status-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }

  .paper-category {
    color: var(--muted-ink);
    font-weight: 600;
  }

  .paper-status-badge {
    background: var(--soft-green);
    color: var(--kalari-green);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
  }

  .paper-date {
    color: var(--muted-ink);
  }

  .paper-title {
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    line-height: 1.18;
    margin-bottom: var(--space-4);
  }

  .paper-authors {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .paper-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: var(--space-8);
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    border: 1px solid var(--rule);
    color: var(--ink);
    background: var(--paper-elevated);
    transition: all var(--duration-fast) ease;
  }

  .action-btn:hover {
    border-color: var(--kalari-green);
    color: var(--kalari-green);
  }

  .pdf-btn {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .pdf-btn:hover {
    background: var(--kalari-green);
    border-color: var(--kalari-green);
    color: var(--paper);
  }

  .paper-abstract-box {
    background: var(--paper-muted);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .abstract-heading {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-ink);
    margin-bottom: var(--space-2);
  }

  .abstract-text {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }

  .paper-body {
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-12);
  }

  .bibtex-section {
    margin-top: var(--space-12);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper-elevated);
  }

  .bibtex-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: var(--paper-muted);
    border-bottom: 1px solid var(--rule);
  }

  .bibtex-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-ink);
  }

  .copy-bibtex-btn {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: var(--ink);
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }

  .copy-bibtex-btn:hover {
    border-color: var(--kalari-green);
    color: var(--kalari-green);
  }

  .bibtex-code {
    padding: 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--ink);
    overflow-x: auto;
    background: var(--paper);
  }
</style>
