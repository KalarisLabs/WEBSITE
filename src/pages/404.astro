---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="404 — Page Not Found"
  description="The requested page could not be found on Kalaris Labs."
  noindex={true}
>
  <Header />
  <main
    id="main-content"
    class="flex min-h-[70vh] items-center justify-center pt-32 pb-20"
  >
    <div class="content-column mx-auto max-w-xl px-4 text-center">
      <span
        class="mono-eyebrow font-mono text-xs tracking-widest text-blue-400 uppercase"
        >Status 404 // Routing Error</span
      >
      <h1
        class="text-foreground mt-4 mb-4 text-5xl font-bold tracking-tight md:text-6xl"
      >
        Page Not Found
      </h1>
      <p
        class="text-muted-foreground mb-8 text-base leading-relaxed md:text-lg"
      >
        The experiment, note, or pathway you requested does not exist or has
        been relocated.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="button button-primary">
          Back to Home <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/research" class="button button-secondary">
          Explore Research Notes
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
