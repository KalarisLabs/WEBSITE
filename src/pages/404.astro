---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="404 — Page Not Found"
  description="The requested page could not be found on Kalaris Labs."
  noindex={true}
>
  <Header />
  <main id="main-content" class="min-h-[70vh] flex items-center justify-center pt-32 pb-20">
    <div class="content-column text-center max-w-xl mx-auto px-4">
      <span class="mono-eyebrow text-xs uppercase tracking-widest text-blue-400 font-mono">Status 404 // Routing Error</span>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-foreground mt-4 mb-4">
        Page Not Found
      </h1>
      <p class="text-muted-foreground text-base md:text-lg leading-relaxed mb-8">
        The experiment, note, or pathway you requested does not exist or has been relocated.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="button button-primary">
          Back to Home <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/research" class="button button-secondary">
          Explore Research Notes
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
