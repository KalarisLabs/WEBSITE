---
import BlogCatalog from '../../components/content/BlogCatalog.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublishedEntries } from '../../lib/content';
import { buildCollectionPageSchema } from '../../lib/seo/schema';
import { absoluteSiteUrl } from '../../lib/seo/site';

export const prerender = true;
const entries = await getPublishedEntries('blog');
const description =
  'Engineering deep-dives and research essays on the model supply chain, agent simulation, specification gaming, machine payments, and closed-loop science.';
const collectionSchema = buildCollectionPageSchema(
  'Kalaris Labs Engineering Blog',
  description,
  absoluteSiteUrl('/blog'),
  entries.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    url: absoluteSiteUrl(`/blog/${entry.id}`),
    publishDate: entry.data.publishDate,
  })),
);
---

<Layout
  title="Engineering Blog"
  description={description}
  extraSchemas={[collectionSchema]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <Header />
  <main id="main-content">
    <BlogCatalog
      entries={entries}
      heading="Engineering blog"
      intro={description}
    />
  </main>
  <Footer />
</Layout>
