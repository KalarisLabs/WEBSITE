---
import BlogCatalog from '../../components/content/BlogCatalog.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublishedEntries } from '../../lib/content';

export const prerender = true;
const entries = await getPublishedEntries('blog');
---

<Layout
  title="Blog · Kalaris Labs"
  description="Engineering notes and technical updates on recursive context and autonomous research systems from Kalaris Labs."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <Header />
  <main id="main-content">
    <BlogCatalog entries={entries} />
  </main>
  <Footer />
</Layout>
