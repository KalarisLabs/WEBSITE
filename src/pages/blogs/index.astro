---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BlogCard from '@/components/ui/BlogCard.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const rawBlogs = await getCollection('blogs');
// Sort by pubDate descending
const publishedBlogs = rawBlogs
  .filter((b) => !b.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Featured post for the top hero banner
const featuredPost = publishedBlogs.find((b) => b.data.featured) || publishedBlogs[0];

// Grid posts: the remaining curated articles
const gridPosts = publishedBlogs.filter((b) => b.id !== featuredPost?.id);

// Unique categories for filter pills
const categories = ['All', 'Launch', 'Research', 'Product'];
---

<BaseLayout
  title="Latest News & Writing | Kalaris Labs"
  description="Research dispatches, technical updates, and architectural breakthroughs from building AI for science."
>
  <Header currentPath="/blogs" />

  <main id="main-content" class="min-h-screen bg-white text-[#111827] pt-10 pb-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">

      <!-- 1. Header Section: Title & Editorial Subtitle (Reference 1) -->
      <header class="mb-10 sm:mb-12">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#111827] mb-3 font-sans">
          Latest news
        </h1>
        <p class="text-sm sm:text-base text-[#4B5563] max-w-2xl leading-relaxed m-0 font-sans">
          Product launches, technical updates, and lessons from building AI for science.
        </p>
      </header>

      <!-- 2. Featured Top Post: 2-Column Hero Card (Reference 1) -->
      {featuredPost && (
        <section class="mb-14 sm:mb-16" aria-label="Featured Story">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center bg-white border border-[#E5E7EB] rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm relative overflow-hidden group hover:border-[#D1D5DB] transition-all">
            
            <!-- Left: Featured Banner / Graphic Canvas -->
            <div class="lg:col-span-7">
              <a
                href={`/blogs/${featuredPost.id}`}
                class="block aspect-[16/10] sm:aspect-[16/9] rounded-xl overflow-hidden relative border border-[#E5E7EB] shadow-xs group-hover:border-[#D1D5DB] transition-colors"
                aria-label={`Read featured article: ${featuredPost.data.title}`}
              >
                <div class="w-full h-full bg-gradient-to-br from-[#0B3B2C] via-[#143B30] to-[#1B4D3E] flex items-center justify-center p-8 text-center relative overflow-hidden group-hover:scale-[1.02] transition-transform duration-500 ease-out">
                  <!-- Ambient radial glow and decorative geometric arcs -->
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.3)_0%,transparent_70%)] pointer-events-none"></div>
                  <div class="absolute -right-12 -bottom-12 w-52 h-52 border border-white/20 rounded-full pointer-events-none"></div>
                  <div class="absolute -left-12 -top-12 w-44 h-44 border border-white/15 rounded-full pointer-events-none"></div>
                  
                  <!-- Center Featured Title Graphic Badge -->
                  <div class="relative z-10 px-6 py-4 rounded-xl backdrop-blur-sm bg-black/35 border border-white/15 shadow-md max-w-[90%]">
                    <span class="font-sans font-bold text-xl sm:text-2xl lg:text-3xl text-white tracking-tight leading-tight block drop-shadow-sm">
                      {featuredPost.data.title}
                    </span>
                    <span class="font-mono text-xs text-emerald-300 tracking-wider uppercase mt-2.5 block font-medium">
                      Featured Research Dispatch
                    </span>
                  </div>
                </div>
              </a>
            </div>

            <!-- Right: Content, Metadata & Read Button -->
            <div class="lg:col-span-5 flex flex-col items-start">
              <h2 class="text-2xl sm:text-3xl font-bold text-[#111827] tracking-tight leading-snug mb-3">
                <a href={`/blogs/${featuredPost.id}`} class="no-underline text-[#111827] hover:text-[#1B4D3E] transition-colors">
                  {featuredPost.data.title}
                </a>
              </h2>

              <p class="text-sm sm:text-base text-[#4B5563] leading-relaxed mb-6">
                {featuredPost.data.description}
              </p>

              <!-- Meta: Date · Category -->
              <div class="flex items-center gap-2 text-xs font-mono text-[#6B7280] mb-8">
                <time datetime={featuredPost.data.pubDate.toISOString()}>
                  {featuredPost.data.pubDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
                <span class="text-[#D1D5DB]">·</span>
                <span class="text-[#1B4D3E] font-medium px-2.5 py-0.5 rounded-full bg-[#EAF2ED] border border-[#C5DBCF]">
                  {featuredPost.data.category || 'Launch'}
                </span>
              </div>

              <!-- Action Button (Reference 1) -->
              <a
                href={`/blogs/${featuredPost.id}`}
                class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#1B4D3E] hover:bg-[#143B30] transition-all shadow-xs no-underline"
              >
                Read the Article
              </a>
            </div>

          </div>
        </section>
      )}

      <!-- 3. Filter Bar & Search Tool (Reference 1) -->
      <section class="mb-10 sm:mb-12" aria-label="Article Filters">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-[#E5E7EB]">
          
          <!-- Category Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-2 md:pb-0 scrollbar-none" id="category-filter-group">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat}
                class={`category-btn px-3.5 py-1.5 rounded-full text-xs font-medium font-sans whitespace-nowrap transition-colors cursor-pointer ${
                  idx === 0
                    ? 'active bg-[#111827] text-white'
                    : 'bg-white text-[#4B5563] hover:text-[#111827] hover:bg-[#F3F4F6] border border-[#E5E7EB]'
                }`}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Right: Search Box & Grid View Icons (Reference 1) -->
          <div class="flex items-center gap-3">
            <div class="relative w-full sm:w-64">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-[#9CA3AF]">
                <svg class="w-3.5 h-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              </span>
              <input
                type="text"
                id="blog-search-input"
                placeholder="Search articles..."
                class="w-full pl-9 pr-3 py-1.5 rounded-lg bg-white border border-[#E5E7EB] text-xs text-[#111827] placeholder-[#9CA3AF] focus:outline-none focus:border-[#1B4D3E] transition-colors font-sans shadow-xs"
              />
            </div>

            <!-- View indicator icon -->
            <div class="hidden sm:flex items-center gap-1 text-[#9CA3AF] border-l border-[#E5E7EB] pl-3">
              <span class="p-1.5 text-[#6B7280]">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16">
                  <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
                </svg>
              </span>
            </div>
          </div>

        </div>
      </section>

      <!-- 4. Clean Responsive Blog Grid (Curated 2-Column Layout) -->
      <section aria-label="Articles Grid">
        <div
          id="blog-cards-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6 sm:gap-8 max-w-5xl"
        >
          {gridPosts.map((post) => (
            <div
              class="blog-card-item"
              data-title={post.data.title.toLowerCase()}
              data-category={(post.data.category || 'Research').toLowerCase()}
            >
              <BlogCard
                title={post.data.title}
                slug={post.id}
                pubDate={post.data.pubDate}
                category={post.data.category || 'Research'}
                description={post.data.description}
                image={post.data.image}
              />
            </div>
          ))}
        </div>

        <!-- No results message -->
        <div id="no-results-msg" class="hidden text-center py-16 text-[#6B7280] font-mono text-xs">
          No articles found matching your criteria. Try resetting the category filter or search query.
        </div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Client-Side Interactive Filtering for Categories & Live Search
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const cardItems = document.querySelectorAll<HTMLElement>('.blog-card-item');
  const noResults = document.getElementById('no-results-msg');

  let activeCategory = 'all';
  let searchQuery = '';

  function filterCards() {
    let visibleCount = 0;

    cardItems.forEach((card) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardTitle = card.getAttribute('data-title') || '';

      const matchesCategory =
        activeCategory === 'all' ||
        cardCategory === activeCategory.toLowerCase();

      const matchesSearch =
        !searchQuery || cardTitle.includes(searchQuery.toLowerCase());

      if (matchesCategory && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => {
        b.classList.remove('active', 'bg-[#111827]', 'text-white');
        b.classList.add('bg-white', 'text-[#4B5563]', 'border', 'border-[#E5E7EB]');
      });

      btn.classList.add('active', 'bg-[#111827]', 'text-white');
      btn.classList.remove('bg-white', 'text-[#4B5563]', 'border', 'border-[#E5E7EB]');

      activeCategory = btn.getAttribute('data-category') || 'all';
      filterCards();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      filterCards();
    });
  }
</script>
