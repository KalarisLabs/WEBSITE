---
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Changelog | Kalaris Labs"
  description="System updates, model releases, and evaluation harness improvements."
  layoutType="reading"
>
  <div class="page-intro">
    <span class="eyebrow">UPDATES & RELEASES</span>
    <h1 class="page-title">Changelog</h1>
  </div>

  <div class="wireframe-placeholder-canvas">
    <div class="wireframe-placeholder-inner">
      <span class="wireframe-tag">Scaffolding Live</span>
      <p class="wireframe-status">
        Ready for reference screenshots & design specs to build out the changelog timeline wireframe.
      </p>
    </div>
  </div>
</PageLayout>

<style>
  .page-intro {
    margin-bottom: var(--space-6);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: var(--space-2);
  }
</style>
