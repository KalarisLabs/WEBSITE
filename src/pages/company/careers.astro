---
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="Careers"
  description="Join Kalaris Labs and help build self-improving infrastructure for scientific research."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Company', url: '/company' },
    { name: 'Careers', url: '/company/careers' },
  ]}
>
  <Header />
  <main id="main-content">
    <header class="page-hero">
      <div class="site-container page-hero-grid">
        <p class="eyebrow">Company / Careers</p>
        <div>
          <h1>No openings yet. High-agency people can still apply.</h1>
          <p class="page-lede">
            We are building a small applied AI research team in India. If you
            investigate problems without waiting for permission and share what
            you learn, we still want to hear from you.
          </p>
        </div>
      </div>
    </header>

    {/* Graphic in front of the user with coordinates and simple apply box */}
    <section class="careers-hero-graphic-section">
      <div class="site-container">
        <div class="careers-card-wrapper">
          <div class="careers-card">
            <div class="careers-card-meta top-left">x 0 y 0</div>
            <div class="careers-card-meta bottom-right">0 selected</div>
            <img
              src="/images/careers-graphic.png"
              alt="Careers at Kalaris Labs: Autonomous infrastructure for scientific discovery"
              width="1729"
              height="910"
              class="careers-card-img"
              loading="eager"
            />
          </div>

          <div class="careers-apply-box">
            <p class="careers-apply-text">
              We're paving the path for autonomous, self-improving
              infrastructure for scientific discovery. We'd love to have you
              join us.
            </p>
            <a
              href="mailto:careers@kalarislabs.com?subject=Working%20with%20Kalaris%20Labs"
              class="button-apply"
            >
              Apply now <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="editorial-section section-rule">
      <div class="site-container editorial-grid">
        <p class="eyebrow">Open roles / 00</p>
        <div class="prose-large">
          <h2>There are no listed roles right now.</h2>
          <p>
            Tell us what you investigate when nobody assigns it, what you have
            built, and why scientific infrastructure matters to you. We care
            more about evidence of agency than a conventional résumé.
          </p>
          <div class="hero-actions">
            <a
              class="button button-primary"
              href="mailto:careers@kalarislabs.com?subject=Working%20with%20Kalaris%20Labs"
            >
              Introduce yourself →
            </a>
            <a class="button button-ghost" href="/team"> Read how we work </a>
          </div>
        </div>
      </div>
    </section>

    <section class="editorial-section dark-band">
      <div class="site-container editorial-grid">
        <p class="eyebrow">What matters / 01</p>
        <div class="prose-large">
          <h2>Curiosity. Agency. Collective ownership.</h2>
          <p>
            We value people who teach what they learn, care about the
            consequence of the work, and can balance intensity with sustainable
            habits. The work should be serious. The culture should still feel
            alive.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
