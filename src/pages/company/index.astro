---
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const values = [
  {
    number: '01',
    title: 'AI for science',
    body: 'We build AI systems around real research work: forming experiments, carrying context forward, and helping more ideas reach evidence.',
  },
  {
    number: '02',
    title: 'AI for good',
    body: 'We measure the work by lives improved. Revenue can keep the research alive, but impact is the point.',
  },
  {
    number: '03',
    title: 'Access changes who discovers',
    body: 'A useful research system should work for a professor, an independent scientist, or a student studying the plants outside their home.',
  },
  {
    number: '04',
    title: 'Knowledge should compound',
    body: 'The infrastructure should learn from every workflow, repository, paper, and iteration instead of resetting when a new experiment begins.',
  },
];

const cultureNotes = [
  'Curiosity is the job.',
  'Everything we learn is shared. Everything we build is collective.',
  'We care about evidence of agency more than conventional credentials.',
];
---

<Layout
  title="Company"
  description="Kalaris Labs is an applied AI research team from India building self-improving infrastructure for scientific discovery."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Company', url: '/company' },
  ]}
>
  <Header />
  <main id="main-content">
    <header class="page-hero company-hero">
      <div class="site-container page-hero-grid">
        <p class="eyebrow">Company / India</p>
        <div>
          <h1>Applied AI for science.</h1>
          <p class="page-lede company-lede">
            Kalaris Labs is an applied AI research team from India. We build
            agent-powered infrastructure that gives scientists more time for
            hypotheses, experiments, and results.
          </p>
        </div>
      </div>
    </header>

    <section class="editorial-section section-rule">
      <div class="site-container editorial-grid">
        <p class="eyebrow">From our manifesto / 01</p>
        <div class="prose-large company-manifesto-copy">
          <h2>Research should be difficult for the right reasons.</h2>
          <p>
            Scientific work asks enough of people already. Researchers should
            not lose their best hours rebuilding test environments, stitching
            together tools, or recovering context from the last experiment.
          </p>
          <p>
            We are building self-improving research infrastructure that learns
            from workflows, repositories, papers, and experimental iterations.
            The goal is direct: help more people spend their time on discovery.
          </p>
          <a class="text-link" href="/manifesto">Read the full manifesto →</a>
        </div>
      </div>
    </section>

    <section class="company-values-section section-rule">
      <div class="site-container company-section-shell">
        <div class="company-section-heading">
          <p class="eyebrow">What guides us / 02</p>
          <h2>AI for good. AI for science.</h2>
        </div>
        <div class="company-values-grid">
          {
            values.map((value) => (
              <article class="company-value-card">
                <p class="mono-number">{value.number}</p>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="editorial-section dark-band">
      <div class="site-container editorial-grid">
        <p class="eyebrow">From the team / 03</p>
        <div class="company-culture-notes">
          {cultureNotes.map((note) => <blockquote>{note}</blockquote>)}
          <p>
            The blend we want is serious research, generous collaboration, and
            people who keep making things outside the boundaries of a job
            description.
          </p>
          <a class="text-link" href="/team">Meet the team →</a>
        </div>
      </div>
    </section>

    <section class="company-careers-section section-rule">
      <div class="site-container company-section-shell">
        <div class="company-section-heading">
          <p class="eyebrow">Work with us / 04</p>
          <h2>No openings yet. High-agency people can still apply.</h2>
        </div>
        <a
          href="/company/careers"
          class="careers-card company-careers-card"
          aria-label="See careers at Kalaris Labs"
        >
          <div class="careers-card-meta top-left">India / applied AI</div>
          <div class="careers-card-meta bottom-right">High agency welcome</div>
          <img
            src="/images/careers-graphic.png"
            alt="Careers at Kalaris Labs"
            width="1729"
            height="910"
            class="careers-card-img"
            loading="lazy"
          />
        </a>
      </div>
    </section>

    <section class="editorial-section section-rule">
      <div class="site-container company-section-shell">
        <p class="eyebrow">More from Kalaris / 05</p>
        <div class="subpage-links company-links-grid">
          <a class="subpage-card" href="/company/news">
            <p class="mono-number">01 / Updates</p>
            <h2>News</h2>
            <p>Announcements, milestones, and notes from the lab.</p>
          </a>
          <a class="subpage-card" href="/press">
            <p class="mono-number">02 / Media</p>
            <h2>Press</h2>
            <p>Company facts, approved descriptions, assets, and contact.</p>
          </a>
          <a class="subpage-card" href="/company/careers">
            <p class="mono-number">03 / Join</p>
            <h2>Careers</h2>
            <p>How high-agency people can introduce themselves to the team.</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
