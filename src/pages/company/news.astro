---
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';
export const prerender = true;
---

<Layout
  title="News"
  description="Company announcements and milestones from Kalaris Labs."
>
  <Header />
  <main id="main-content">
    <header class="page-hero">
      <div class="site-container page-hero-grid">
        <p class="eyebrow">Company / News</p><div>
          <h1>Notes from the lab.</h1><p class="page-lede">
            Announcements, milestones, and an honest record of what we are
            learning as we build.
          </p>
        </div>
      </div>
    </header>
    <section class="editorial-section section-rule">
      <div class="site-container editorial-grid">
        <p class="eyebrow">Status / 2026</p><div class="prose-large">
          <h2>The archive starts here.</h2><p>
            There are no public company announcements yet. When there is
            something worth saying, it will appear here—dated, attributable, and
            without manufactured momentum.
          </p><div class="hero-actions">
            <a class="button button-ghost" href="/blog">Read the blog →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
