---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import DesignPartners from '../components/sections/DesignPartners.astro';
import ResearchCarousel from '../components/sections/ResearchCarousel.astro';
import CareersBanner from '../components/sections/CareersBanner.astro';
import FellowshipBanner from '../components/sections/FellowshipBanner.astro';
import Faq from '../components/sections/Faq.astro';
import { FAQS } from '../data/faqs';
import { buildFaqSchema } from '../lib/seo/schema';

export const prerender = true;
---

<Layout
  title="Kalaris Labs"
  seoTitle="Kalaris Labs: Infrastructure for the agentic era"
  description="Kalaris Labs is a research lab building the infrastructure for the agentic era: agent harnesses, protocols, multi-agent simulation, evaluations, and AI safety research that keep agents safe, clean, and governable."
  extraSchemas={[buildFaqSchema(FAQS)]}
>
  <Header />
  <main id="main-content">
    <Hero />
    <DesignPartners />
    <ResearchCarousel />
    <FellowshipBanner />
    <CareersBanner />
    <Faq />
  </main>
  <Footer />
</Layout>
