---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import DesignPartners from '../components/sections/DesignPartners.astro';
import ResearchCarousel from '../components/sections/ResearchCarousel.astro';
import BlogCarousel from '../components/sections/BlogCarousel.astro';
import CareersBanner from '../components/sections/CareersBanner.astro';

export const prerender = true;
---

<Layout
  title="Kalaris Labs - Self-improving research infrastructure"
  description="Kalaris Labs builds recursive, self-improving infrastructure for scientific research."
>
  <Header />
  <main id="main-content">
    <Hero />
    <DesignPartners />
    <ResearchCarousel />
    <BlogCarousel />
    <CareersBanner />
  </main>
  <Footer />
</Layout>
