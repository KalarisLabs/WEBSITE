---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import DesignPartners from '../components/sections/DesignPartners.astro';
import ResearchCarousel from '../components/sections/ResearchCarousel.astro';
import CareersBanner from '../components/sections/CareersBanner.astro';

export const prerender = true;
---

<Layout
  title="Kalaris Labs"
  description="Agent-powered infrastructure for scientific discovery, built for researchers everywhere."
>
  <Header />
  <main id="main-content">
    <Hero />
    <DesignPartners />
    <ResearchCarousel />
    <CareersBanner />
  </main>
  <Footer />
</Layout>
