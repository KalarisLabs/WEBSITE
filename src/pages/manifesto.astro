---
import manifestoSource from '../../manifesto.md?raw';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
const paragraphs = manifestoSource.trim().split(/\r?\n\r?\n/);
const [title, ...body] = paragraphs;
---

<Layout
  title="Manifesto"
  description="Self-improving scientific research infrastructure for the democratization of research."
>
  <Header />
  <main id="main-content" class="manifesto-page">
    <article class="essay-column">
      <header><h1>{title}</h1></header>
      <div class="manifesto-copy">
        {
          body.map((paragraph, index) =>
            index === 0 ? (
              <p class="manifesto-opening">{paragraph}</p>
            ) : (
              <p>{paragraph}</p>
            ),
          )
        }
      </div>
    </article>
  </main>
  <Footer />
</Layout>
