---
import manifestoSource from '../../manifesto.md?raw';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
const paragraphs = manifestoSource.trim().split(/\r?\n\r?\n/);
const [title, ...body] = paragraphs;
---

<Layout
  title="Manifesto"
  description="The Kalaris Labs manifesto: why research infrastructure should improve itself with every experiment, and why scientific discovery belongs to everyone, everywhere."
  type="article"
  publishDate={new Date('2026-01-01T00:00:00.000Z')}
  section="Research"
  authorName="Sayan Chowdhury"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Manifesto', url: '/manifesto' },
  ]}
>
  <Header />
  <main id="main-content" class="manifesto-page">
    <article class="essay-column">
      <header><h1>{title}</h1></header>
      <div class="manifesto-copy">
        {
          body.map((paragraph, index) =>
            index === 0 ? (
              <p class="manifesto-opening">{paragraph}</p>
            ) : (
              <p>{paragraph}</p>
            ),
          )
        }
      </div>
    </article>
  </main>
  <Footer />
</Layout>
