---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const facts = [
  ['Base', 'India'],
  ['Field', 'AI research'],
  ['Focus', 'Infrastructure for the agentic era'],
  ['Principle', 'AI for good'],
];
---

<Layout
  title="Press"
  description="Company facts, approved descriptions, media assets, and press contact for Kalaris Labs."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Press', url: '/press' },
  ]}
>
  <Header />
  <main id="main-content" class="press-page">
    <header class="page-hero">
      <div class="site-container page-hero-grid">
        <p class="eyebrow">Company / Press</p>
        <div>
          <h1>Kalaris Labs in brief.</h1>
          <p class="page-lede">
            Company facts, approved language, visual assets, and a direct line
            to the team.
          </p>
        </div>
      </div>
    </header>

    <section class="press-section section-rule">
      <div class="site-container press-shell">
        <div class="press-intro">
          <p class="eyebrow">Boilerplate / 01</p>
          <div>
            <h2>An AI research lab from India.</h2>
            <p>
              Kalaris Labs is a research lab building the infrastructure for the
              agentic era. Its work spans agent harnesses, continual and
              reinforcement learning, multi-agent simulation, game theory and
              the economics of agents, agent protocols, evaluations, and AI
              safety and security.
            </p>
          </div>
        </div>

        <dl class="press-facts">
          {
            facts.map(([term, description]) => (
              <div class="press-fact">
                <dt>{term}</dt>
                <dd>{description}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="press-section dark-band">
      <div class="site-container press-shell">
        <div class="press-intro">
          <p class="eyebrow">Focus / 02</p>
          <div>
            <h2>What we are working toward.</h2>
            <ul class="press-focus-list">
              <li>Agent infrastructure that is safe, clean, and governable.</li>
              <li>Open protocols for how agents communicate and transact.</li>
              <li>
                Multi-agent simulation and game theory for the agentic economy.
              </li>
              <li>
                Evaluations that are hard to game, with safety research
                throughout.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="press-section section-rule">
      <div class="site-container press-shell">
        <div class="press-intro">
          <p class="eyebrow">Assets / 03</p>
          <div>
            <h2>Marks and media.</h2>
            <p>
              Please preserve the proportions and clear space of each mark. Do
              not recolour, distort, or place the logo over a low-contrast
              background.
            </p>
            <div class="press-assets">
              <a href="/kalaris-wordmark.png" download>Download wordmark →</a>
              <a href="/kalaris-logo-geometric.png" download
                >Download symbol →</a
              >
              <a href="/images/kalaris-hero-banner.png" download
                >Download banner →</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="press-contact-section">
      <div class="site-container press-contact-card">
        <p class="eyebrow">Press contact / 04</p>
        <h2>Working on a story?</h2>
        <p>
          Send the publication, topic, and deadline. We will route it to the
          right person on the team.
        </p>
        <a
          class="button button-primary"
          href="mailto:hello@kalarislabs.com?subject=Press%20inquiry"
        >
          Contact Kalaris Labs →
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
