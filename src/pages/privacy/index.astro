---
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Privacy Policy | Kalaris Labs"
  description="Privacy policy and data sovereignty terms for Kalaris Labs."
  layoutType="reading"
>
  <div class="page-intro">
    <span class="eyebrow">DATA SOVEREIGNTY & PRIVACY</span>
    <h1 class="page-title">Privacy Policy</h1>
  </div>

  <div class="wireframe-placeholder-canvas">
    <div class="wireframe-placeholder-inner">
      <span class="wireframe-tag">Scaffolding Live</span>
      <p class="wireframe-status">
        Ready for reference screenshots & legal brief to build out the privacy and data sovereignty wireframe.
      </p>
    </div>
  </div>
</PageLayout>

<style>
  .page-intro {
    margin-bottom: var(--space-6);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: var(--space-2);
  }
</style>
