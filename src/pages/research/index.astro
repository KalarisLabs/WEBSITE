---
import ResearchCatalog from '../../components/content/ResearchCatalog.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublishedEntries } from '../../lib/content';

export const prerender = true;
const entries = await getPublishedEntries('research');
---

<Layout
  title="Research · Kalaris Labs"
  description="System notes, capability diagnostics, and empirical architectures for compounding scientific discovery."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Research', url: '/research' },
  ]}
>
  <Header />
  <main id="main-content">
    <ResearchCatalog entries={entries as any} />
  </main>
  <Footer />
</Layout>
