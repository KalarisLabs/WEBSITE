---
import ResearchCatalog from '../../components/content/ResearchCatalog.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublishedEntries } from '../../lib/content';
import { buildCollectionPageSchema } from '../../lib/seo/schema';
import { absoluteSiteUrl } from '../../lib/seo/site';

export const prerender = true;
const entries = await getPublishedEntries('research');
const description =
  'Research from Kalaris Labs, including Skill Doctor: deterministic, multi-layer security analysis for AI agent skill files.';
const collectionSchema = buildCollectionPageSchema(
  'Kalaris Labs Research Notes',
  description,
  absoluteSiteUrl('/research'),
  entries.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    url: absoluteSiteUrl(`/research/${entry.id}`),
    publishDate: entry.data.publishDate,
  })),
);
---

<Layout
  title="Research Notes"
  description={description}
  extraSchemas={[collectionSchema]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Research', url: '/research' },
  ]}
>
  <Header />
  <main id="main-content">
    <ResearchCatalog
      entries={entries}
      heading="Research notes"
      intro={description}
    />
  </main>
  <Footer />
</Layout>
