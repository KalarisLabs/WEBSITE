---
import cultureSource from '../../culture.md?raw';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Layout from '../layouts/Layout.astro';
import { buildFounderPersonSchema } from '../lib/seo/schema';
import { initials, people } from '../data/people';

export const prerender = true;
const cultureParagraphs = cultureSource.trim().split(/\r?\n\r?\n/);
const [cultureTitle, ...cultureBody] = cultureParagraphs;
const teamMembers = people.filter((person) => person.group === 'team');
---

<Layout
  title="Our Team"
  description="Meet the team behind Kalaris Labs, founded by Sayan Chowdhury, and how we work: agency, curiosity, shared knowledge, and commitment to research that compounds."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Team', url: '/team' },
  ]}
  extraSchemas={[buildFounderPersonSchema()]}
>
  <Header />
  <main id="main-content" class="team-page">
    <div class="content-column team-intro">
      <h1>{cultureTitle}</h1>
      <div class="culture-copy">
        {cultureBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <section class="founders-section">
      <div class="content-column">
        <h2>Founders</h2>
        <article class="founder-card">
          <div class="founder-image">
            <img
              src="/founders/sayan-chowdhury.jpg"
              alt="Sayan Chowdhury"
              width="460"
              height="460"
              loading="lazy"
            />
          </div>
          <div class="founder-name">
            <p>Sayan Chowdhury</p><span>Founder</span>
          </div>
          <div class="founder-bio">
            <p>
              Agentic researcher and builder focused on systems architecture,
              agent infrastructure, and the economic layer of agentic systems.
            </p><a href="https://www.linkedin.com/in/sayanchowdhuryai"
              >LinkedIn ↗</a
            ><a href="/team/sayan-chowdhury">View profile →</a>
          </div>
          <aside class="founder-fact">
            <span>Fun fact</span><p>
              He describes himself as an ADHD builder and entrepreneur at heart:
              architecture before wrappers.
            </p>
          </aside>
        </article>
      </div>
    </section>

    <section class="founders-section">
      <div class="content-column">
        <h2>Team</h2>
        <ul class="person-grid" role="list">
          {
            teamMembers.map((person) => (
              <li>
                <a class="person-card" href={`/team/${person.slug}`}>
                  {person.image ? (
                    <img
                      src={person.image}
                      alt={person.name}
                      class="person-avatar-img"
                      width="48"
                      height="48"
                      loading="lazy"
                    />
                  ) : (
                    <span class="person-monogram" aria-hidden="true">
                      {initials(person.name)}
                    </span>
                  )}
                  <span class="person-card-name">{person.name}</span>
                  <span class="person-card-role">{person.role}</span>
                  <span class="person-card-cta" aria-hidden="true">
                    View profile →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
