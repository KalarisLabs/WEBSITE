{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalaris-labs-website",
  "account_id": "d59494a6afb6b5913ff800704c98e8e0",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Serve /research from research/index.html without a slash redirect, to
    // match Astro's trailingSlash: 'never' and the canonical URLs.
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "ratelimits": [
    // Per-IP: non-GET/HEAD requests only; page and asset reads are never throttled.
    {
      "name": "SITE_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 600, "period": 60 },
    },
    // Per-IP: contact form submissions.
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "vars": {
    "APP_ENV": "development",
    "CONTACT_TO_EMAIL": "hello@kalarislabs.com",
    "CONTACT_FROM_EMAIL": "Kalaris Labs <hello@kalarislabs.com>",
  },
  "env": {
    "staging": {
      "name": "kalaris-labs-website-staging",
      "workers_dev": true,
      "ratelimits": [
        // Per-IP: non-GET/HEAD requests only; page and asset reads are never throttled.
        {
          "name": "SITE_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 600, "period": 60 },
        },
        // Per-IP: contact form submissions.
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "CONTACT_TO_EMAIL": "hello@kalarislabs.com",
        "CONTACT_FROM_EMAIL": "Kalaris Labs <hello@kalarislabs.com>",
      },
    },
    "production": {
      "name": "kalaris-labs-website",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "kalarislabs.com",
          "custom_domain": true,
        },
        {
          "pattern": "www.kalarislabs.com",
          "custom_domain": true,
        },
      ],
      "ratelimits": [
        // Per-IP: non-GET/HEAD requests only; page and asset reads are never throttled.
        {
          "name": "SITE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 600, "period": 60 },
        },
        // Per-IP: contact form submissions.
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "CONTACT_TO_EMAIL": "hello@kalarislabs.com",
        "CONTACT_FROM_EMAIL": "Kalaris Labs <hello@kalarislabs.com>",
      },
    },
  },
}
